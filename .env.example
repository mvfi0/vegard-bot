# Copy this file to .env and fill in your values — NEVER put real secrets here

# ── Discord bot ───────────────────────────────────────────────────────────────
# Get your token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Bot command prefix for legacy text commands (default: !)
COMMAND_PREFIX=!

# ── Odysseus core ─────────────────────────────────────────────────────────────
# URL where the FastAPI core service is running
ODYSSEUS_URL=http://localhost:8000

# Ollama model to use — must be pulled first: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b

# ── Chat channel ──────────────────────────────────────────────────────────────
# ID of the dedicated free-chat channel (no command needed there).
# Leave blank to disable — bot will only respond to @mentions or /chat elsewhere.
CHAT_CHANNEL_ID=
